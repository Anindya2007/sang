generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  userId       Int      @id @default(autoincrement())
  name         String   @db.VarChar(100)
  email        String   @unique @db.VarChar(150)
  phone        String   @unique @db.VarChar(15)
  passwordHash String
  createdAt    DateTime @default(now())

  // Relationships
  roles       UserRole[]
  communities UserCommunity[]
  vehicles    Vehicle[]
  rides       Ride[]
  bookings    Booking[]

  // Ratings given and received
  ratingsGiven    Rating[] @relation("RatingsGiven")
  ratingsReceived Rating[] @relation("RatingsReceived")

  // Cancellations performed by this user
  cancellations Cancellation[]

  @@map("users")
}
model UserRole {
  userId Int
  role   String @db.VarChar(20)

  user User @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@id([userId, role])
  @@map("user_roles")
}

model Community {
  communityId  Int    @id @default(autoincrement())
  name         String @db.VarChar(150)
  communityType String @db.VarChar(20)
  emailDomain  String @unique @db.VarChar(150)

  users UserCommunity[]
  rides Ride[]

  @@map("communities")
}



model Ride {
  rideId         Int      @id @default(autoincrement())
  driverId       Int
  vehicleId      Int
  communityId    Int
  source         String   @db.VarChar(255)
  destination    String   @db.VarChar(255)
  rideDate       DateTime @db.Date
  departureTime  DateTime @db.Time
  totalSeats     Int
  availableSeats Int
  farePerSeat    Decimal  @db.Decimal(10, 2)
  status         String   @db.VarChar(20)

  driver    User      @relation(fields: [driverId], references: [userId])
  vehicle   Vehicle   @relation(fields: [vehicleId], references: [vehicleId])
  community Community @relation(fields: [communityId], references: [communityId])

  bookings Booking[]
  ratings  Rating[]

  @@map("rides")
}

model Booking {
  bookingId     Int           @id @default(autoincrement())
  rideId        Int
  riderId       Int
  seatsBooked   Int
  bookingStatus String        @db.VarChar(20)
  bookedAt      DateTime      @default(now())

  ride          Ride          @relation(fields: [rideId], references: [rideId], onDelete: Cascade)
  rider         User          @relation(fields: [riderId], references: [userId], onDelete: Cascade)
  cancellation  Cancellation?

  @@map("bookings")
}

model Cancellation {
  cancellationId  Int       @id @default(autoincrement())
  bookingId       Int       @unique
  cancelledBy     Int
  reason          String?
  cancelledAt     DateTime  @default(now())
  cancellationFee Decimal?  @db.Decimal(10, 2)

  booking         Booking   @relation(fields: [bookingId], references: [bookingId], onDelete: Cascade)
  user            User      @relation(fields: [cancelledBy], references: [userId])

  @@map("cancellations")
}
model Vehicle {
  vehicleId      Int    @id @default(autoincrement())
  driverId       Int
  vehicleModel   String @db.VarChar(100)
  registrationNo String @unique @db.VarChar(30)
  vehicleType    String @db.VarChar(30)
  seatCapacity   Int

  driver User   @relation(fields: [driverId], references: [userId], onDelete: Cascade)
  rides  Ride[]

  @@map("vehicles")
}
